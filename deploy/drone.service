[Unit]
Description=VyomGarud GCS Drone Middleware
After=network.target zerotier-one.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/gcs-production
EnvironmentFile=/home/ubuntu/gcs-production/backend/.env
ExecStart=/usr/local/go/bin/go run /home/ubuntu/gcs-production/backend/main.go
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
