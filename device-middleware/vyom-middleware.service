[Unit]
Description=Vyom Device Middleware
After=network.target network-online.target systemd-timesyncd.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/bin
ExecStart=/usr/local/bin/vyom-middleware
Restart=always
RestartSec=3s
StartLimitInterval=0

# Environment Configuration
Environment=CheckUpdate=true
Environment=GIN_MODE=release

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vyom-middleware

[Install]
WantedBy=multi-user.target
